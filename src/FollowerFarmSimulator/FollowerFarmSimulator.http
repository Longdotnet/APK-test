@host = http://localhost:5000

### Create 10,000 synthetic accounts
POST {{host}}/api/accounts/generate
Content-Type: application/json

{
  "count": 10000
}

### Inspect pool
GET {{host}}/api/accounts/stats

### Create a simulated direct-follow campaign
POST {{host}}/api/campaigns
Content-Type: application/json

{
  "target": "demo_target",
  "quantity": 1000,
  "startingFollowers": 100
}

### Replace CAMPAIGN_ID after creating campaign
GET {{host}}/api/campaigns/CAMPAIGN_ID

### Refill missing delivery with unused eligible accounts
POST {{host}}/api/campaigns/CAMPAIGN_ID/refill

### Read simulated target count
GET {{host}}/api/targets/demo_target

### Recent jobs
GET {{host}}/api/jobs/recent?take=50
