<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>RobloxPiano.App.ClientEntryPoint</StartupObject>
    <AssemblyName>RobloxPiano</AssemblyName>
    <RootNamespace>RobloxPiano.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RobloxPiano.Core/RobloxPiano.Core.csproj" />
    <ProjectReference Include="../RobloxPiano.Library/RobloxPiano.Library.csproj" />
  </ItemGroup>
</Project>
