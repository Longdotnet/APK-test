<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>RobloxPiano.App.ClientEntryPoint</StartupObject>
    <AssemblyName>RobloxPiano</AssemblyName>
    <RootNamespace>RobloxPiano.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RobloxPiano.Core/RobloxPiano.Core.csproj" />
    <ProjectReference Include="../RobloxPiano.Library/RobloxPiano.Library.csproj" />
    <ProjectReference Include="../RobloxPiano.Audio/RobloxPiano.Audio.csproj" />
  </ItemGroup>

  <!--
    Microsoft.ML.OnnxRuntime carries native import/static .lib files for build/link consumers.
    They are not runtime assets for the managed Windows client and must not escape beside the
    self-contained executable. Keep the removal exact so an unrelated future native asset cannot
    be silently discarded by extension alone.
  -->
  <Target Name="ExcludeOnnxRuntimeImportLibrariesFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.lib' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_shared.lib'" />
    </ItemGroup>
  </Target>
</Project>
